---
import { getCollection } from "astro:content";
import katex from "katex";
import Checks from "../components/Checks.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, newestFirst } from "../lib/frontmatter";
import { EQUATION_IDS, EQUATIONS, TAG_IDS, TAGS } from "../lib/taxonomy";
import { HERO_SLUG, heroUrl, thumbnailUrl } from "../viz/thumbnails";

const entries = (await getCollection("phenomena")).sort(newestFirst);
const heroEntry = entries.find((e) => e.id === HERO_SLUG);
const heroEquation = heroEntry ? katex.renderToString(heroEntry.data.equation, { displayMode: true }) : "";
const tileEquation = (tex: string) => katex.renderToString(tex, { displayMode: true });
const thumbs = new Map(await Promise.all(entries.map(async (e) => [e.id, await thumbnailUrl(e.id)] as const)));
const hero = { wide: await heroUrl("wide"), tall: await heroUrl("tall") };

// 絞り込みのチップ: 語彙（taxonomy.ts）の順に、1 ページ以上に付いている語だけ
const count = (pred: (e: (typeof entries)[number]) => boolean) => entries.filter(pred).length;
const eqChips = EQUATION_IDS.map((id) => ({ id, label: EQUATIONS[id].label, n: count((e) => e.data.equations.includes(id)) })).filter((c) => c.n > 0);
const tagChips = TAG_IDS.map((id) => ({ id, label: TAGS[id].label, n: count((e) => e.data.tags.includes(id)) })).filter((c) => c.n > 0);
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <figure class="hero-figure">
      <picture>
        <source media="(max-width: 47.99rem)" srcset={hero.tall} />
        <img
          src={hero.wide}
          width="1920"
          height="960"
          alt="非線形 Schrödinger 方程式の 2 つのソリトンが衝突する時空図。横軸が位置 x、縦軸が時刻 t（下から上）。2 本の明るい帯が中央で交わって X 字を描く。"
          fetchpriority="high"
        />
      </picture>
      <span class="hero-cursor" aria-hidden="true"></span>
    </figure>
    <div class="hero-text">
      <h1 id="hero-title"><span class="nb">非線形分散型方程式の</span><span class="nb">数値実験</span></h1>
      <div class="hero-equation" set:html={heroEquation} />
    </div>
  </section>

  <div class="container">
    <div class="lede">
      <p class="hero-note">
        <span class="bar-key" aria-hidden="true"></span>
        上の図は <a href={`/phenomena/${HERO_SLUG}/`}>{heroEntry?.data.title ?? HERO_SLUG}</a> と同じ solver でビルドのたびに計算した時空図です。横が位置
        <i class="mi">x</i>（−40 から 40）、縦が時刻 <i class="mi">t</i>（下の 0 から上の 40）、明るさが <span class="num">|<i class="mi">u</i>|</span>。
      </p>

      <div class="intro prose">
        <p>
          非線形 Schrödinger 方程式や KdV 方程式などの分散型方程式で起きる現象を、計算して見せます。
          各ページには、動かせるシミュレーションと解説、そしてその計算が数値の誤りでないことを確かめた検証の記録を載せています。
        </p>
      </div>
    </div>

    <div class="list-head" id="phenomena">
      <h2>現象</h2>
      <p>
        <span data-count>{entries.length} ページ</span>。公開日の新しい順。各ページの「保存量」「収束」「厳密解」は、その計算で確かめた検証の種類と件数です。
      </p>
    </div>

    <form class="filters" data-filters hidden aria-label="一覧の絞り込み" onsubmit="return false">
      <fieldset class="filter-group">
        <legend>方程式<span class="rule">（選んだどれかを扱うページ）</span></legend>
        <div class="chips">
          {
            eqChips.map((c) => (
              <button type="button" class="chip" data-kind="eq" data-id={c.id} aria-pressed="false">
                {c.label}
                <span class="chip-n">{c.n}</span>
              </button>
            ))
          }
        </div>
      </fieldset>
      <fieldset class="filter-group">
        <legend>タグ<span class="rule">（選んだすべてが付いたページ）</span></legend>
        <div class="chips">
          {
            tagChips.map((c) => (
              <button type="button" class="chip" data-kind="tag" data-id={c.id} aria-pressed="false">
                {c.label}
                <span class="chip-n">{c.n}</span>
              </button>
            ))
          }
        </div>
      </fieldset>
      <p class="filter-status">
        <span data-status aria-live="polite"></span>
        <button type="button" class="button quiet" data-clear hidden>条件を外す</button>
      </p>
    </form>

    <p class="filter-empty" data-empty hidden>
      条件に合うページはありません。方程式を足すか、タグを減らしてください。
      <button type="button" class="button quiet" data-clear>条件をすべて外す</button>
    </p>

    <ul class="plates">
      {
        entries.map((e) => (
          <li data-eq={e.data.equations.join(" ")} data-tags={e.data.tags.join(" ")}>
            <a class="plate" href={`/phenomena/${e.id}/`}>
              <figure class="plate-figure">
                {thumbs.get(e.id) ? (
                  <img src={thumbs.get(e.id)!} width="640" height="480" loading="lazy" alt="" />
                ) : (
                  <span class="tile-equation" set:html={tileEquation(e.data.equation)} />
                )}
              </figure>
              <div class="plate-meta">
                <span class="equations">{e.data.equations.map((q) => EQUATIONS[q].label).join("、")}</span>
                <Checks kinds={e.data.verification.map((v) => v.kind)} />
              </div>
              <h3>
                {e.data.title}
                {e.data.preprint && (
                  <>
                    {" "}
                    <span class="badge" title={`査読前の preprint（arXiv:${e.data.preprint.arxiv}v${e.data.preprint.version}）に基づく`}>
                      preprint
                    </span>
                  </>
                )}
              </h3>
              <p>{e.data.summary}</p>
              <div class="plate-foot">
                <time datetime={e.data.published}>{formatDate(e.data.published)}</time>
                <ul class="tags">
                  {e.data.tags.map((t) => (
                    <li>{TAGS[t].label}</li>
                  ))}
                </ul>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<script>
  import { EQUATION_IDS, TAG_IDS } from "../lib/taxonomy";
  import { filterToQuery, isEmpty, matches, parseFilter, queryString, toggle, type Filter } from "../site/filter";

  // JS が無いときは絞り込みの欄を出さず、全件を見せる（progressive enhancement）
  const form = document.querySelector<HTMLFormElement>("[data-filters]");
  const items = [...document.querySelectorAll<HTMLLIElement>(".plates > li")];
  const status = document.querySelector<HTMLElement>("[data-status]");
  const count = document.querySelector<HTMLElement>("[data-count]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const valid = { eq: new Set<string>(EQUATION_IDS), tag: new Set<string>(TAG_IDS) };

  if (form && status && count && empty) {
    let filter: Filter = parseFilter(new URLSearchParams(location.search), valid);

    const render = () => {
      let shown = 0;
      for (const li of items) {
        const ok = matches({ equations: (li.dataset.eq ?? "").split(" "), tags: (li.dataset.tags ?? "").split(" ").filter(Boolean) }, filter);
        li.hidden = !ok;
        if (ok) shown++;
      }
      for (const chip of form.querySelectorAll<HTMLButtonElement>(".chip")) {
        const kind = chip.dataset.kind as keyof Filter;
        chip.setAttribute("aria-pressed", String(filter[kind].includes(chip.dataset.id ?? "")));
      }
      const all = items.length;
      count.textContent = isEmpty(filter) ? `${all} ページ` : `${all} ページ中 ${shown} ページ`;
      status.textContent = isEmpty(filter) ? "" : `${shown} 件が条件に合います。`;
      for (const b of document.querySelectorAll<HTMLButtonElement>("[data-clear]")) b.hidden = isEmpty(filter);
      empty.hidden = shown > 0;
    };

    const commit = (next: Filter) => {
      filter = next;
      const qs = queryString(filterToQuery(filter, new URLSearchParams(location.search)));
      history.replaceState(null, "", `${location.pathname}${qs ? `?${qs}` : ""}${location.hash}`);
      render();
    };

    form.addEventListener("click", (ev) => {
      const chip = (ev.target as HTMLElement).closest<HTMLButtonElement>(".chip");
      if (chip?.dataset.kind && chip.dataset.id) commit(toggle(filter, chip.dataset.kind as keyof Filter, chip.dataset.id));
    });
    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-clear]")) b.addEventListener("click", () => commit({ eq: [], tag: [] }));

    form.hidden = false;
    render();
  }
</script>
