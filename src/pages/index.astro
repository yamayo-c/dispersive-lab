---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const entries = (await getCollection("phenomena")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <h1>非線形分散型方程式の数値実験</h1>
  <p class="lead">
    非線形 Schrödinger 方程式などの分散型方程式で起きる現象を、ブラウザの中で計算して見せます。
    各ページには、解説と動くシミュレーション、そしてその計算が数値の誤りでないことを確かめた検証を載せています。
  </p>

  <ul class="phenomenon-list">
    {
      entries.map((e) => (
        <li>
          <a class="phenomenon-card" href={`/phenomena/${e.id}/`}>
            <h2>
              {e.data.title}
              {!e.data.reviewed && (
                <span class="badge unreviewed" title="自動で生成・検証して公開。著者による数学的な確認はまだ">
                  未査読
                </span>
              )}
              {e.data.preprint && (
                <span class="badge preprint" title={`査読前の preprint（arXiv:${e.data.preprint.arxiv}v${e.data.preprint.version}）に基づく`}>
                  preprint
                </span>
              )}
            </h2>
            <p>{e.data.summary}</p>
            {e.data.tags.length > 0 && (
              <ul class="tags">
                {e.data.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
