---
import type { CollectionEntry } from "astro:content";
import katex from "katex";
import Simulation from "../components/Simulation";
import { arxivUrl, formatDate } from "../lib/frontmatter";
import { EQUATIONS, TAGS } from "../lib/taxonomy";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"phenomena">;
}

const { entry } = Astro.props;
const { title, summary, equation, verification, preprint, published, equations, tags } = entry.data;
const hasSim = `../content/phenomena/${entry.id}/sim.ts` in import.meta.glob("../content/phenomena/*/sim.ts");
const equationHtml = katex.renderToString(equation, { displayMode: true, throwOnError: true });

const KIND_LABEL = {
  conservation: "保存量",
  convergence: "収束",
  exact: "厳密解",
} as const;

const repo = "https://github.com/yamayo-c/dispersive-lab/blob/main";
const testUrl = `${repo}/src/content/phenomena/${entry.id}/verify.test.ts`;
const simUrl = `${repo}/src/content/phenomena/${entry.id}/sim.ts`;
---

<BaseLayout title={title} description={summary}>
  <article class="container">
    <header class="ph-head">
      <p class="ph-meta">
        <span>{equations.map((q) => EQUATIONS[q].label).join("、")}</span>
        <time datetime={published}>{formatDate(published)} 公開</time>
      </p>
      <h1>{title}</h1>
      {
        preprint && (
          <p class="notice">
            <span class="badge">preprint</span>
            査読前の preprint（<a href={arxivUrl(preprint)}>arXiv:{preprint.arxiv}v{preprint.version}</a>）に基づくページです。今後の版で結果が変わったり、取り下げられたりすることがあります。
          </p>
        )
      }
      <p class="ph-summary">{summary}</p>
      <div class="ph-equation" set:html={equationHtml} />
    </header>

    {hasSim && <Simulation slug={entry.id} client:only="react" />}

    <div class="ph-body">
      <div class="prose">
        <slot />
      </div>
    </div>

    <section class="record" aria-labelledby="record-heading">
      <h2 id="record-heading">この計算の検証</h2>
      <p class="record-intro">
        このページと同じ solver を Node で動かすテスト（<a href={testUrl}>verify.test.ts</a>）として、変更のたびに CI で確かめている。{
          hasSim && (
            <>
              初期値とパラメータの定義は <a href={simUrl}>sim.ts</a>。
            </>
          )
        }
      </p>
      <ol>
        {
          verification.map((v) => (
            <li>
              <span class="check on">{KIND_LABEL[v.kind]}</span>
              <span>{v.description}</span>
            </li>
          ))
        }
      </ol>
      {
        tags.length > 0 && (
          <ul class="tags record-tags">
            {tags.map((t) => (
              <li>{TAGS[t].label}</li>
            ))}
          </ul>
        )
      }
    </section>
  </article>
</BaseLayout>
