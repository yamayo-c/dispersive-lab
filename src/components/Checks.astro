---
/**
 * 検証の種類の印（保存量・収束・厳密解）。一覧の各現象と、その凡例に使う。
 * 3 つの枠をいつも同じ順に並べ、そのページが持つ種類だけを塗る。
 */
type Kind = "conservation" | "convergence" | "exact";

interface Props {
  kinds: readonly Kind[];
  /** 凡例として、すべてを塗らずに枠だけで出す */
  legend?: boolean;
}

const KIND_LABEL: Record<Kind, string> = {
  conservation: "保存量",
  convergence: "収束",
  exact: "厳密解",
};

const ORDER: Kind[] = ["conservation", "convergence", "exact"];
const { kinds, legend = false } = Astro.props;
const has = new Set(kinds);
const label = legend
  ? "検証の種類: 保存量、収束（解像度・時間刻みを半分にした比較）、厳密解"
  : `検証: ${ORDER.filter((k) => has.has(k)).map((k) => KIND_LABEL[k]).join("、")}`;
---

<span class="checks" role="img" aria-label={label} title={legend ? "各ページで確かめた検証の種類（塗りつぶしがそのページにあるもの）" : undefined}>
  {
    ORDER.map((k) => (
      <span class={`check ${legend ? "legend" : has.has(k) ? "on" : "off"}`} aria-hidden="true">
        {KIND_LABEL[k]}
      </span>
    ))
  }
</span>
